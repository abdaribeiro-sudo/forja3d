# === Tencent Cloud (Hunyuan 3D) ===
# Console: https://console.tencentcloud.com/cam/capi
TENCENT_SECRET_ID=seu_secret_id_aqui
TENCENT_SECRET_KEY=sua_secret_key_aqui
TENCENT_REGION=ap-singapore

# === Mercado Pago ===
# Painel: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
# URL pública do backend para receber webhooks do MP (ex: https://api.forja3d.com.br/api/payment/webhook)
MP_WEBHOOK_URL=https://seu-backend.railway.app/api/payment/webhook

# === URLs ===
# URL pública do frontend (para redirecionamento após pagamento)
FRONTEND_URL=http://localhost:3000
# Origens permitidas no CORS (separadas por vírgula, * para dev)
ALLOWED_ORIGINS=*

# === Banco de Dados ===
# Local: postgresql+asyncpg://postgres:postgres@localhost:5433/forja3d
# Railway: usa a DATABASE_URL fornecida automaticamente
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/forja3d

# === Correios ===
# CEP de origem para cálculo de frete (Nova Friburgo, RJ)
CORREIOS_CEP_ORIGEM=28035030

# === Admin ===
# Senha do painel administrativo (trocar em produção!)
ADMIN_PASSWORD=trocar_em_producao

# === Storage ===
# Diretório local para arquivos GLB (em produção, será efêmero no Railway)
STORAGE_PATH=./uploads

# === Agent lifecycle ===
# Senha compartilhada entre backend e printer-agent para /api/printer/*
# Gerar com: openssl rand -hex 32
AGENT_PASSWORD=trocar_em_producao
# Minutos até considerar um pedido PREPARANDO como órfão (agent crashou)
ORPHAN_PREPARING_MINUTES=45

# === Email (Resend) ===
# API key do Resend — https://resend.com/api-keys
# Sem este valor, emails são logados mas não enviados (best-effort).
RESEND_API_KEY=
# Endereço de envio (domínio precisa estar verificado no Resend)
EMAIL_FROM="FORJA3D <pedidos@forja3d.com.br>"
